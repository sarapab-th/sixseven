# ============================================================
#  SIXSEVEN — environment variables
#  Copy this file to ".env.local" and fill in what you use.
#  Everything here is optional: with none of it set the site
#  still runs, and quote requests are written to
#  storage/quote-requests.jsonl so nothing is lost.
# ============================================================

# Your live domain. Used for canonical URLs, the sitemap and
# the file-download links inside notification emails.
NEXT_PUBLIC_SITE_URL=https://sixseven.co.th

# ---------- EMAIL (pick ONE) --------------------------------

# Option A — Resend (easiest; no extra packages)
#   1. sign up at resend.com, verify your domain
#   2. paste the API key here
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option B — your own SMTP server (Google Workspace, your host, …)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=orders@sixseven.co.th
# SMTP_PASS=your-app-password

# Who the notification comes from and goes to.
# MAIL_FROM must be an address on a domain your provider has verified.
# MAIL_FROM=SixSeven Website <website@sixseven.co.th>
# MAIL_TO=orders@sixseven.co.th

# ---------- FILE STORAGE ------------------------------------

# "local" (default) writes to ./storage/uploads — right for a VPS,
#   Docker, or anywhere with a real disk.
# "blob" uses Vercel Blob — needed on serverless hosts where the
#   filesystem is wiped between requests. Run: pnpm add @vercel/blob
STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ---------- SEO ---------------------------------------------

# From Google Search Console → Settings → Ownership verification → HTML tag
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxx
